.env.test.local
.env.production.local
*.pem
*.key
*.p12

# =========================================================================
# 4. Java & Spring Boot (Maven Build Outputs)
# =========================================================================
**/target/
**/*.jar
**/*.war
**/*.ear
**/*.zip
**/*.tar.gz
**/*.rar
**/pom.xml.tag
**/pom.xml.releaseBackup
**/pom.xml.next
**/release.properties
**/dependency-reduced-pom.xml
**/buildNumber.properties
**/.mvn/timing.properties
**/.mvn/wrapper/maven-wrapper.jar

# =========================================================================
